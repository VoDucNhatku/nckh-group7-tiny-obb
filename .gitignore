# Whitelist: ignore everything, then re-include only what the team shares.
# Paper PDFs, SLR reading notes, raw caches (~1.3 GB) and logs stay local on purpose
# (copyright + size). To share a new file, add a "!path" line below.
/*
!/.gitignore
!/README.md
!/ROADMAP.md
!/ROADMAP-14w-backup.md

# --- proposal & decisions (notes/) ---
!/notes/
/notes/*
!/notes/t07-c3-proposal-v2-EN.md
!/notes/Group7.pdf
!/notes/Group7-proposal-presentation.pptx
!/notes/t07-foundation-G7-VI-v2.pdf
!/notes/t07-foundation-G7-VI-v3.pdf
!/notes/t07-foundation-review-2026-10-09.md
!/notes/t07-session-qa-2026-10-09.md
!/notes/t07-c3-proposal-template-EN.docx
!/notes/t07-c3-introduction-EN.pptx
!/notes/t07-c3-evidence-dossier.md
!/notes/t07-c3-novelty-rescan.md
!/notes/claims-ledger.md
!/notes/r3-final-comparison.md
!/notes/t07-tier-upgrade.md
!/notes/synthesize-gaps-t07-q4-priority.md
!/notes/t07-proposal.md
!/notes/figs/
!/notes/t07-critique-q2-2026-10-11.md
!/notes/t07-dl-digest-2026-10-11.md
!/notes/t07-dl-from-slides-VI.pdf
!/notes/t07-dl-from-slides/
/notes/t07-dl-from-slides/_qa/
/notes/t07-dl-from-slides/*.print.html
/notes/t07-dl-from-slides/lab_err.txt

# --- scripts that rebuild the proposal figures / docx ---
!/scripts/
/scripts/*
!/scripts/t07-slr/
/scripts/t07-slr/*
!/scripts/t07-slr/common.py
!/scripts/t07-slr/p12_proposal_figures.py
!/scripts/t07-slr/p13_build_proposal_docx.js

# --- experiments & manuscript (shared from day one) ---
!/experiments/
!/paper/

# --- never commit, even inside shared folders ---
~$*
*.tmp
__pycache__/
.ipynb_checkpoints/
*.pt
*.pth
*.ckpt
*.onnx
experiments/**/weights/
experiments/**/data/
.env
*.key
kaggle.json
