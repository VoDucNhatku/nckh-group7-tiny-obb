# Whitelist at the root: ignore everything, then re-include only what the team shares.
# Paper PDFs, raw caches (~1.3 GB), data and logs stay local on purpose (copyright + size).
# Inside notes/ everything is shared EXCEPT any `_local/` folder and `sources/` caches.
# Rules for where files go: AGENTS.md.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/ROADMAP.md
!/C11_colab.ipynb
!/notebooks/

# --- research notes (notes/): shared by default ---
!/notes/
_local/
/notes/**/sources/*
!/notes/**/sources/README.md
/notes/**/_qa/
/notes/**/*.print.html
/notes/**/lab_err.txt

# --- scripts that rebuild the proposal figures / docx ---
!/scripts/
/scripts/*
!/scripts/t07-slr/
/scripts/t07-slr/*
!/scripts/t07-slr/common.py
!/scripts/t07-slr/p12_proposal_figures.py
!/scripts/t07-slr/p13_build_proposal_docx.js

# --- C11 / C11x experiment code (C11 code still lives on the team Drive; push it here via a PR) ---
!/scripts/c11/
!/scripts/c11x/

# --- experiments & manuscript (shared from day one) ---
!/experiments/
!/paper/

# --- never commit, even inside shared folders ---
~$*
*.tmp
__pycache__/
.ipynb_checkpoints/
*.pt
*.pth
*.ckpt
*.onnx
experiments/**/weights/
experiments/**/data/
.env
*.key
kaggle.json
